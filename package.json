{
  "name": "xlink-technician-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "test:main-h5-boot": "playwright test --config playwright.main-h5-bootstrap.config.ts",
    "test:main-h5-mock": "playwright test --config playwright.main-h5-mock.config.ts",
    "capture:s2-ux-sheet": "playwright test --config playwright.s2-ux-review.config.ts",
    "check:s2-ux-sheet": "node scripts/check-s2-ux-review.mjs",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-weixin:prod-readonly": "uni -p mp-weixin --mode prod",
    "dev:h5-review": "vite --config vite.review.config.ts",
    "build:h5-review": "vite build --config vite.review.config.ts --outDir unpackage/h5-review",
    "dev:uni-h5-review": "vite --config vite.uni-h5-review.config.ts",
    "dev:uni-h5-g4f-review": "vite --config vite.uni-h5-g4f-review.config.ts",
    "build:uni-h5-review": "vite build --config vite.uni-h5-review.config.ts",
    "build:uni-h5-g4f-review": "vite build --config vite.uni-h5-g4f-review.config.ts",
    "build:mp-weixin-review": "uni build -p mp-weixin -c vite.mp-weixin-review.config.ts --outDir ../unpackage/design-system-mp-weixin",
    "test:design-system-review": "playwright test tests/h5-review/design-system.spec.ts",
    "test:uni-h5-review": "playwright test --config playwright.uni-h5-review.config.ts",
    "test:uni-h5-g4f-review": "playwright test --config playwright.uni-h5-g4f-review.config.ts",
    "test:uni-h5-g4f-phase1b-review": "playwright test --config playwright.uni-h5-g4f-review.config.ts tests/h5-review/g4f-quotation-phase1b.spec.ts",
    "check:g4f-phase1a": "node scripts/check-g4f-phase1a.mjs",
    "check:g4f-phase1b": "node scripts/check-g4f-phase1b.mjs",
    "check:g4f-synthetic-extfield-review": "node scripts/check-g4f-synthetic-extfield-review.mjs",
    "check:g4e-review-harness": "node scripts/check-g4e-review-harness.mjs",
    "test:h5-review": "playwright test",
    "capture:g4e-review": "playwright test tests/h5-review/g4e-survey.spec.ts",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "inspect:form-schema": "node scripts/inspect-inspection-contract.mjs",
    "verify:g4f-prod-read": "node scripts/verify-g4f-prod-read.mjs",
    "inspect:g4f-active-order-extfield": "node scripts/inspect-g4f-active-order-extfield.mjs",
    "inspect:inspection-contract": "node scripts/inspect-inspection-contract.mjs",
    "inspect:inspection-contract:beta": "node scripts/inspect-inspection-contract-beta.mjs",
    "capture:survey-contract:beta": "node scripts/capture-survey-contract-beta.mjs",
    "generate:survey-media": "node scripts/generate-survey-media-contract.mjs",
    "check:survey-media": "node scripts/check-survey-media.mjs",
    "check:survey-media-p0": "node scripts/check-survey-media-p0.mjs",
    "check:survey-camera-watermark": "node scripts/check-survey-camera-watermark.mjs",
    "check:inspection-contract": "node scripts/check-inspection-contract.mjs",
    "check:survey-contract": "node scripts/check-survey-contract.mjs",
    "check:survey-capabilities": "node scripts/check-survey-capabilities.mjs",
    "check:survey-leakage-cause": "node scripts/check-survey-leakage-cause.mjs",
    "check:survey-onsite-checkin": "node scripts/check-survey-onsite-checkin.mjs",
    "check:g4e-closure-readiness": "node scripts/check-g4e-closure-readiness.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm run check:boundaries && pnpm run check:ui-governance && pnpm run check:m1-i8-baseline && pnpm run check:g4f-phase1a && pnpm run check:g4f-phase1b && pnpm run check:g4f-synthetic-extfield-review && pnpm run typecheck && pnpm run test",
    "check:ui-governance": "node scripts/check-ui-governance.mjs",
    "check:m1-i8-baseline": "node scripts/check-m1-i8-baseline.mjs",
    "test:ds02a:gallery": "playwright test --config playwright.ds02a-gallery.config.ts",
    "test:ds02a:business": "playwright test --config playwright.ds02a-main.config.ts",
    "check:quality": "node scripts/eq01-quality-census.mjs --check",
    "verify:quick": "pnpm run check:boundaries && pnpm run check:ui-governance && pnpm run check:m1-i8-baseline && pnpm run typecheck && pnpm exec vitest run tests/g4f/quotation-order-browse-handoff.test.ts tests/g4f/quotation-order-read.test.ts tests/g4f/quotation-order-signing-read-boundary.test.ts tests/g4f/quotation-local-review-closure.test.ts tests/ds03/transaction-visual-contract.test.ts tests/ds05/mobile-craft-two-page.test.ts tests/engineering/eq01-mock-scenarios.test.ts tests/engineering/eq02-action-draft-helpers.test.ts",
    "verify:full": "pnpm run verify && pnpm run check:quality"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-ui": "1.5.12",
    "@vue/devtools-api": "6.6.4",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/shared": "3.4.21",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-demi": "0.14.10"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vitejs/plugin-vue": "5.2.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "18.19.130",
    "@vue/compiler-sfc": "3.4.21",
    "sass": "1.77.8",
    "typescript": "4.9.5",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue-tsc": "1.8.27"
  }
}
