{
  "name": "xlink-technician-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5-review": "vite --config vite.review.config.ts",
    "build:h5-review": "vite build --config vite.review.config.ts --outDir unpackage/h5-review",
    "test:design-system-review": "playwright test tests/h5-review/design-system.spec.ts",
    "check:g4e-review-harness": "node scripts/check-g4e-review-harness.mjs",
    "test:h5-review": "playwright test",
    "capture:g4e-review": "playwright test tests/h5-review/g4e-survey.spec.ts",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "inspect:form-schema": "node scripts/inspect-inspection-contract.mjs",
    "inspect:inspection-contract": "node scripts/inspect-inspection-contract.mjs",
    "inspect:inspection-contract:beta": "node scripts/inspect-inspection-contract-beta.mjs",
    "capture:survey-contract:beta": "node scripts/capture-survey-contract-beta.mjs",
    "generate:survey-media": "node scripts/generate-survey-media-contract.mjs",
    "check:survey-media": "node scripts/check-survey-media.mjs",
    "check:survey-media-p0": "node scripts/check-survey-media-p0.mjs",
    "check:survey-camera-watermark": "node scripts/check-survey-camera-watermark.mjs",
    "check:inspection-contract": "node scripts/check-inspection-contract.mjs",
    "check:survey-contract": "node scripts/check-survey-contract.mjs",
    "check:survey-capabilities": "node scripts/check-survey-capabilities.mjs",
    "check:survey-leakage-cause": "node scripts/check-survey-leakage-cause.mjs",
    "check:survey-onsite-checkin": "node scripts/check-survey-onsite-checkin.mjs",
    "check:g4e-closure-readiness": "node scripts/check-g4e-closure-readiness.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm run check:boundaries && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-ui": "1.5.12",
    "@vue/devtools-api": "6.6.4",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/shared": "3.4.21",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-demi": "0.14.10"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@playwright/test": "^1.63.0",
    "@types/node": "18.19.130",
    "@vue/compiler-sfc": "3.4.21",
    "sass": "1.77.8",
    "typescript": "4.9.5",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue-tsc": "1.8.27"
  }
}
