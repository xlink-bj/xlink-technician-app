{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vite/client", "@dcloudio/types"],
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@shared/*": ["src/shared/*"],
      "@adapters/*": ["src/adapters/*"],
      "@runtimes/*": ["src/runtimes/*"],
      "@features/*": ["src/features/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.d.ts",
    "playwright.config.ts",
    "playwright.uni-h5-g4f-review.config.ts",
    "vite.uni-h5-g4f-review.config.ts",
    "tools/review/quotation-demo/**/*.ts",
    "tools/review/quotation-demo/**/*.vue",
    "tools/review/harness/**/*.ts",
    "tools/review/harness/**/*.vue",
    "vite.review.config.ts"
  ],
  "exclude": ["node_modules", "dist", "unpackage"]
}
